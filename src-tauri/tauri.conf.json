{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hoyo-auth",
  "version": "0.1.1",
  "identifier": "com.learnrepo.hoyoauth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "胡桃工具箱 · 学习复刻版",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/icimence/OpenHoyo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERUExMDYyM0YyNUY3QgpSV1I3WC9JakJxSGVEaTdmMGtBMEk1dHQ4RU1maEJnSng4VFhiTnU2NTd5czdxaS9zUURWalJzTgo="
    }
  }
}
