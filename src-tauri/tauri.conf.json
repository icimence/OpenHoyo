{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "霜舞工具箱",
  "mainBinaryName": "hoyo-auth",
  "version": "0.2.2",
  "identifier": "com.learnrepo.hoyoauth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "霜舞工具箱 · FrostDance",
        "width": 1200,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "android": {
      "minSdkVersion": 35
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cnb.cool/openhoyo/openhoyo-release/-/releases/latest/download/latest.json",
        "https://github.com/icimence/OpenHoyo/releases/latest/download/latest.json",
        "https://openhoyo-updates.oss-cn-hangzhou.aliyuncs.com/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVERUExMDYyM0YyNUY3QgpSV1I3WC9JakJxSGVEaTdmMGtBMEk1dHQ4RU1maEJnSng4VFhiTnU2NTd5czdxaS9zUURWalJzTgo="
    }
  }
}
